# ===== ToolTopia — Vercel Environment Variables =====
# Copy this file to .env.local for local development.
# Never commit .env.local (it is gitignored).

# PostgreSQL connection string (Neon). Get it from Neon dashboard:
# https://neon.tech -> Project -> Connect -> Connection string
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/tooltopia?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET="replace-with-a-long-random-secret"

# Comma-separated list of hostnames allowed to submit Turnstile tokens
TURNSTILE_HOSTNAMES="localhost:3000,tooltopia.vercel.app"

# First admin account created by the seed script
ADMIN_EMAIL="admin@tooltopia.app"
ADMIN_NAME="ToolTopia Admin"
ADMIN_PASSWORD="replace-with-a-strong-password"